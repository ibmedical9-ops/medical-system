# ===== قاعدة البيانات =====
# mysql (موصى به للاستضافة) أو sqlite (تشغيل محلي بلا إعداد)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/prompt_trap_lab.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prompt_trap_lab
DB_USER=root
DB_PASS=

# ===== مزود الذكاء الاصطناعي =====
# simulation (افتراضي، محلي بالكامل، بلا مفاتيح) | openai_compatible | anthropic
AI_PROVIDER=simulation
AI_API_KEY=
AI_MODEL=
# للمزودات المتوافقة مع واجهة OpenAI (مثل Ollama المحلي: http://localhost:11434/v1)
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=30

# ===== عام =====
APP_ENV=production
